+#if defined(__ANDROID__)
+    static std::atomic<AndroidWindowProvider> androidWindowProvider{ nullptr };
+
+    void setAndroidWindowProvider(AndroidWindowProvider provider) {
+        androidWindowProvider.store(provider);
+    }
+
+    // Moves the swap chain to the window the provider returns if it isn't the one in use (the
+    // surface was destroyed in the background and recreated). False while there is no window.
+    static bool updateAndroidSurface(VulkanSwapChain *swapChain) {
+        AndroidWindowProvider provider = androidWindowProvider.load();
+        if (provider == nullptr) {
+            return true;
+        }
+
+        ANativeWindow *window = provider();
+        if (window == nullptr) {
+            return false;
+        }
+
+        bool updated = true;
+        if ((window != swapChain->desc.renderWindow) || (swapChain->surface == VK_NULL_HANDLE)) {
+            swapChain->releaseImageViews();
+            swapChain->releaseSwapChain();
+
+            VulkanInterface *renderInterface = swapChain->commandQueue->device->renderInterface;
+            if (swapChain->surface != VK_NULL_HANDLE) {
+                vkDestroySurfaceKHR(renderInterface->instance, swapChain->surface, nullptr);
+                swapChain->surface = VK_NULL_HANDLE;
+            }
+
+            // The surface keeps its own reference to the window.
+            VkAndroidSurfaceCreateInfoKHR surfaceCreateInfo = {};
+            surfaceCreateInfo.sType = VK_STRUCTURE_TYPE_ANDROID_SURFACE_CREATE_INFO_KHR;
+            surfaceCreateInfo.window = window;
+            VkResult res = vkCreateAndroidSurfaceKHR(renderInterface->instance, &surfaceCreateInfo, nullptr, &swapChain->surface);
+            if (res == VK_SUCCESS) {
+                swapChain->desc.renderWindow = window;
+            }
+            else {
+                fprintf(stderr, "vkCreateAndroidSurfaceKHR failed with error code 0x%X.\n", res);
+                swapChain->surface = VK_NULL_HANDLE;
+                updated = false;
+            }
+        }
+
+        ANativeWindow_release(window);
+        return updated;
+    }
+#endif
+
     bool VulkanSwapChain::resize() {
+#   if defined(__ANDROID__)
+        if (!updateAndroidSurface(this)) {
+            return false;
+        }
+#   endif
+
