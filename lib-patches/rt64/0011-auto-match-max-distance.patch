+        // away and fly across the screen in the interpolated frames. Left unpaired, it's drawn where it is.
+        // Nothing in the game moves this far in one frame (shells about 110 units).
+        const float MaxPositionDifference = 256.0f;
+        if (matchResult.positionDifference > MaxPositionDifference) {
+            return matchResult;
+        }
