         matchResult.positionDifference = hlslpp::length(curPos - prevPos);
 
+        // BattleTanx recomp: don't pair transforms that are too far apart to be the same object one frame later.
+        // Matching has no distance limit otherwise, so when objects drawn with the same model come into or go out
