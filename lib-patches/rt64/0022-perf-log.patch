+    // BattleTanx recomp, testing only (round 146): BTGA_RT64_PERF_LOG=1 prints once a second the
+    // worst game frame's times in the workload thread and how long the game waited for a free slot.
+    struct BtgaPerf {
+        bool enabled = false;
+        std::mutex mutex;
+        std::chrono::steady_clock::time_point windowStart = std::chrono::steady_clock::now();
+        int workloads = 0, displayFramesSum = 0, renderedSum = 0, skippedWorkloads = 0;
+        uint64_t maxPairs = 0, groupsSkipped = 0;
+        double maxSetupMs = 0, maxFrame0Ms = 0, maxTotalMs = 0, maxWaitMs = 0, sumWaitMs = 0, maxStallMs = 0, sumStallMs = 0;
+        BtgaPerf() {
+            const char *v = getenv("BTGA_RT64_PERF_LOG");
+            enabled = (v != nullptr) && (v[0] != '\0') && (v[0] != '0');
+        }
+        void report() {
+            auto now = std::chrono::steady_clock::now();
+            if (std::chrono::duration<double>(now - windowStart).count() < 1.0) {
+                return;
+            }
+            fprintf(stdout, "[RT64 PERF] %d frames: in-between %d drawn of %d, %d frames cut short; worst: setup+match %.1f ms, "
+                "first draw %.1f ms, all draws %.1f ms, wait for present %.1f ms (total %.1f); game waited for a slot: worst %.1f ms, total %.1f ms; "
+                "match pairs worst %llu, look-alike groups not matched %llu\n",
+                workloads, renderedSum - workloads, displayFramesSum - workloads, skippedWorkloads, maxSetupMs, maxFrame0Ms, maxTotalMs,
+                maxWaitMs, sumWaitMs, maxStallMs, sumStallMs, (unsigned long long)maxPairs, (unsigned long long)groupsSkipped);
+            fflush(stdout);
+            *this = BtgaPerf();
+            enabled = true;
+        }
+        BtgaPerf &operator=(const BtgaPerf &o) {
+            enabled = o.enabled; windowStart = o.windowStart; workloads = o.workloads; displayFramesSum = o.displayFramesSum;
+            renderedSum = o.renderedSum; skippedWorkloads = o.skippedWorkloads; maxSetupMs = o.maxSetupMs; maxFrame0Ms = o.maxFrame0Ms;
+            maxTotalMs = o.maxTotalMs; maxWaitMs = o.maxWaitMs; sumWaitMs = o.sumWaitMs; maxStallMs = o.maxStallMs; sumStallMs = o.sumStallMs;
+            maxPairs = o.maxPairs; groupsSkipped = o.groupsSkipped;
+            return *this;
+        }
+    };
+    static BtgaPerf btgaPerf;
+
+    static double btgaMs(std::chrono::steady_clock::time_point a, std::chrono::steady_clock::time_point b) {
+        return std::chrono::duration<double, std::milli>(b - a).count();
+    }
