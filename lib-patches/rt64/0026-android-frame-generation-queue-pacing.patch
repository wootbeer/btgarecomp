--- a/src/hle/rt64_present_queue.cpp
+++ b/src/hle/rt64_present_queue.cpp
@@ -500,8 +500,25 @@
         // refresh more or less than the others, and a pan judders. Otherwise, timed.
         const uint32_t frameCount = generatedFrames + 1;
         const uint32_t refreshRate = ext.sharedResources->swapChainRate;
+        // BattleTanx recomp (Android): no present wait there (not on Android 13 at least), so the timed
+        // presents judder, worse at 60 Hz than at 120. A FIFO swap chain shows every present for at least one
+        // refresh, in order: presenting the frames back to back, each once per refresh of its share, lets the
+        // queue pace them instead. The acquire blocks once the swap chain's images are all queued.
+#   if defined(__ANDROID__)
+        const bool queuePacing = !presentWaitEnabled && ext.swapChain->isVsyncEnabled();
+#   else
+        const bool queuePacing = false;
+#   endif
+        static int loggedPacing = -1;
+        const int pacing = presentWaitEnabled ? 0 : (queuePacing ? 1 : 2);
+        if (pacing != loggedPacing) {
+            static const char *pacingNames[] = { "present wait", "the swap chain's queue", "timed presents" };
+            fprintf(stderr, "[RT64] Frame generation paced by %s (refresh rate %u Hz).\n", pacingNames[pacing], refreshRate);
+            loggedPacing = pacing;
+        }
+
         uint32_t refreshes = 0;
-        if (presentWaitEnabled && (refreshRate > 0) && (refreshRate < 1000) && (spacing.count() > 0)) {
+        if ((presentWaitEnabled || queuePacing) && (refreshRate > 0) && (refreshRate < 1000) && (spacing.count() > 0)) {
             refreshes = uint32_t(std::lround(double(spacing.count()) * frameCount * refreshRate / 1e9));
             if (refreshes < frameCount) {
                 refreshes = 0;
@@ -568,7 +585,7 @@
                 ext.presentGraphicsWorker->commandQueue->executeCommandLists(&constCommandList, 1, &waitSemaphore, 1, &signalSemaphore, 1, ext.presentGraphicsWorker->commandFence.get());
                 ext.presentGraphicsWorker->wait();
 
-                if (refreshes > 0) {
+                if ((refreshes > 0) && presentWaitEnabled) {
                     // Until the last present is on screen: one present per refresh.
                     ext.swapChain->wait();
                 }
