diff --git a/src/hle/rt64_application.cpp b/src/hle/rt64_application.cpp
index ee8bc1f..c2c9587 100644
--- a/src/hle/rt64_application.cpp
+++ b/src/hle/rt64_application.cpp
@@ -325,7 +325,13 @@ namespace RT64 {
         // Create the swap chain with the texture count specified from the configuration.
         RenderSwapChainDesc swapChainDesc;
         swapChainDesc.renderWindow = appWindow->windowHandle;
+#   if defined(__ANDROID__)
+        // Android surfaces offer RGBA8, not BGRA8. Keep in step with the video interface pipelines
+        // in rt64_shader_library.cpp.
+        swapChainDesc.format = RenderFormat::R8G8B8A8_UNORM;
+#   else
         swapChainDesc.format = RenderFormat::B8G8R8A8_UNORM;
+#   endif
         swapChainDesc.textureCount = (userConfig.displayBuffering == UserConfiguration::DisplayBuffering::Triple) ? 3 : 2;
 
         // Enable present wait if supported by the device. We specify a max latency of 1 as we use it to wait right before the next
diff --git a/src/render/rt64_shader_library.cpp b/src/render/rt64_shader_library.cpp
index d1c5273..5f0fdb5 100644
--- a/src/render/rt64_shader_library.cpp
+++ b/src/render/rt64_shader_library.cpp
@@ -599,7 +599,12 @@ namespace RT64 {
             RenderGraphicsPipelineDesc pipelineDesc;
             pipelineDesc.vertexShader = fullScreenVertexShader.get();
             pipelineDesc.pixelShader = regularShader.get();
+#       if defined(__ANDROID__)
+            // The swap chain is RGBA8 on Android (rt64_application.cpp).
+            pipelineDesc.renderTargetFormat[0] = RenderFormat::R8G8B8A8_UNORM;
+#       else
             pipelineDesc.renderTargetFormat[0] = RenderFormat::B8G8R8A8_UNORM; // TODO: Use whatever format the swap chain was created with.
+#       endif
             pipelineDesc.renderTargetBlend[0] = RenderBlendDesc::Copy();
             pipelineDesc.renderTargetCount = 1;
             pipelineDesc.pipelineLayout = videoInterfaceNearest.pipelineLayout.get();
