+// Deterministic mode: the order events are handed over in when several are
+// waiting (as the console would raise them: DMA, SI, RSP, RDP, then the
+// retrace's audio and video interrupts).
+static int deterministic_rank(int src) {
+    switch (static_cast<ultramodern::EventMessageSource>(src)) {
+        case ultramodern::EventMessageSource::Pi: return 0;
+        case ultramodern::EventMessageSource::Si: return 1;
+        case ultramodern::EventMessageSource::Sp: return 2;
+        case ultramodern::EventMessageSource::Dp: return 3;
+        case ultramodern::EventMessageSource::Ai: return 4;
+        case ultramodern::EventMessageSource::Vi: return 5;
+        case ultramodern::EventMessageSource::Timer: return 6;
+    }
+    return 7;
+}
+
+// Deterministic mode, with every game thread waiting: the RSP tasks and
+// display lists still running finish now (in the game's time they take
+// none), and what they and the game's own requests raised is handed over;
+// with nothing raised, time moves on to the next retrace.
+static void deterministic_idle(RDRAM_ARG1) {
+    static std::vector<QueuedMessage> held{}; // sends that found the queue full, to try again
+    ultramodern::wait_for_deterministic_tasks();
+    std::vector<QueuedMessage> messages = std::move(held);
+    held.clear();
+    QueuedMessage queued;
+    bool raised = false;
+    while (external_messages.try_dequeue(queued)) {
+        messages.push_back(queued);
+        raised = true;
+    }
+    if (!raised) {
+        ultramodern::deterministic_vi_tick();
+        while (external_messages.try_dequeue(queued)) {
+            messages.push_back(queued);
+        }
+    }
+    std::stable_sort(messages.begin(), messages.end(), [](const QueuedMessage& a, const QueuedMessage& b) {
+        return deterministic_rank(a.src) < deterministic_rank(b.src);
+    });
