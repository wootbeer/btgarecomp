+// Deterministic mode: one retrace, from the game's idle point (every game
+// thread waiting). Paced to the host's clock so the game doesn't run ahead of
+// it, but never skipped: a slow frame just shows later.
+void ultramodern::deterministic_present() {
+    events_context.action_queue.enqueue(ScreenUpdateAction{ events_context.vi.regs });
+}
+
+void ultramodern::deterministic_vi_tick() {
+    using namespace std::chrono_literals;
+    static auto epoch = std::chrono::high_resolution_clock::now();
+    uint64_t vis = ++deterministic_vis;
+    // Signed: with the count's unsigned type in it, a retrace not yet due
+    // came out far behind, and the game ran unpaced.
+    auto since_epoch = std::chrono::microseconds(static_cast<int64_t>(vis) * 1000000 / 60);
+    auto due = epoch + since_epoch;
+    // Far behind (the game waited, for the other player in netplay): on from
+    // now, rather than hurrying to catch up.
+    auto now = std::chrono::high_resolution_clock::now();
+    if (now - due > 100ms) {
+        epoch = now - since_epoch;
+        due = now;
+    }
+    ultramodern::sleep_until(due);
+
+    events_context.action_queue.enqueue(ScreenUpdateAction{ events_context.vi.regs });
+    events_context.vi.update_vi();
+    {
+        uint8_t* rdram = events_context.rdram;
+        std::lock_guard lock{ events_context.message_mutex };
+        ViState* cur_state = events_context.vi.get_cur_state();
+        if (--deterministic_remaining_retraces <= 0) {
+            if (cur_state->mq != NULLPTR) {
+                ultramodern::enqueue_external_message_src(cur_state->mq, cur_state->msg, false, ultramodern::EventMessageSource::Vi);
+            }
+            deterministic_remaining_retraces = cur_state->retrace_count;
+        }
+        if (events_context.ai.mq != NULLPTR) {
+            ultramodern::enqueue_external_message_src(events_context.ai.mq, events_context.ai.msg, false, ultramodern::EventMessageSource::Ai);
+        }
+    }
+    ultramodern::deterministic_audio_tick();
+    if (events_callbacks.vi_callback != nullptr) {
+        events_callbacks.vi_callback();
+    }
+}
