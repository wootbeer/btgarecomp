+void recomp::mods::ModContext::disable_all_mods_unsaved() {
+    std::vector<std::string> enabled(enabled_mods.begin(), enabled_mods.end());
+    for (const std::string& mod_id : enabled) {
+        enable_mod(mod_id, false, false);
+    }
+    auto_enabled_mods.clear();
+}
+
 bool recomp::mods::ModContext::is_mod_enabled(const std::string& mod_id) const {
     return enabled_mods.contains(mod_id);
 }
