+void renderer::RT64Context::update_screen_held() {
+    // RT64 repeats the last workload and present while its debugger pauses;
+    // paused only for this call, so no display list is ever skipped.
+    app->state->debuggerInspector.paused = true;
+    app->updateScreen();
+    app->state->debuggerInspector.paused = false;
+}
